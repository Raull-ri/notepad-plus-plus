#==============================================================================
# МАКРОС СОЗДАНИЯ БУФЕРНЫХ ЗОН ВОКРУГ ВЗРЫВНОГО БЛОКА
# Для GEOVIA Surpac 6/7 (TCL/SCL)
# Использует реальный Surpac SWA API
#==============================================================================

#==============================================================================
# ДИАЛОГОВАЯ ФОРМА ДЛЯ ВВОДА ПАРАМЕТРОВ
#==============================================================================

set form {
  GuidoForm buffer_frm {
    -default_buttons
    -label "Создание буферных зон вокруг блока"
    -layout BoxLayout Y_AXIS
    
    GuidoPanel panel1 {
      -layout CentreLineLayout VERTICAL LEFT
      
      # Входной файл с контуром блока
      GuidoFileBrowserField in_block_file {
        -label "Файл с контуром блока"
        -format none
        -translate none
        -display_length 25
        -file_mask "*.str"
        -null false
      }
      
      GuidoFiller fill1 {-height 0.25}
      
      # Номер слоя с блоком
      GuidoField block_layer {
        -label "Номер слоя блока"
        -null false
        -default 1
        -low_bound 1
        -high_bound 999
        -display_length 10
      }
      
      GuidoFiller fill2 {-height 0.25}
      
      # Радиусы буферов
      GuidoField radii_input {
        -label "Радиусы буферов (через запятую, м)"
        -null false
        -default "250,500"
        -display_length 25
      }
      
      GuidoFiller fill3 {-height 0.25}
      
      # Режим построения
      GuidoChoiceField buffer_mode {
        -label "Режим построения"
        -null false
        -default 0
        -choices {"Круги от центра" "Оффсет контура"}
      }
      
      GuidoFiller fill4 {-height 0.25}
      
      # Добавлять подписи
      GuidoCheckBoxField add_labels {
        -label "Добавить подписи радиусов"
        -default false
      }
      
      GuidoFiller fill5 {-height 0.25}
      
      # Выходной файл
      GuidoFileBrowserField out_buffer_file {
        -label "Выходной файл с буферами"
        -format none
        -translate none
        -display_length 25
        -file_mask "*.str"
        -null false
      }
    }
  }
}

#==============================================================================
# СОЗДАНИЕ И ЗАПУСК ФОРМЫ
#==============================================================================

SclCreateGuidoForm formHandle $form {}
$formHandle SclRun {}

if {$_status != "apply"} {
  puts "Операция отменена пользователем"
  exit
}

#==============================================================================
# ОСНОВНАЯ ЛОГИКА МАКРОСА
#==============================================================================

# Парсинг радиусов
set radii_string [string map {" " ""} $radii_input]
set radii_list [split $radii_string ","]

puts "=========================================="
puts "Создание буферных зон"
puts "=========================================="
puts "Входной файл: $in_block_file"
puts "Слой блока: $block_layer"
puts "Радиусы: $radii_list"
puts "Режим: $buffer_mode"
puts "=========================================="

#------------------------------------------------------------------------------
# ШАГ 1: ОТКРЫТИЕ ВХОДНОГО ФАЙЛА И ЧТЕНИЕ КОНТУРА БЛОКА
#------------------------------------------------------------------------------

SclCreateSwa SwaHandleInput "strings"
$SwaHandleInput SclSwaOpenFile $in_block_file

# Получаем коллекцию строк
$SwaHandleInput SclGetStrings StringsHandle

# Ищем строку в нужном слое
set block_found 0
set block_vertices {}
set sum_x 0.0
set sum_y 0.0
set vertex_count 0

$StringsHandle SclIterateLast StringsIterator
while {[$StringsIterator SclIteratePrev StringHandle] == $SCL_TRUE} {
  
  # Проверяем слой строки
  set str_layer [$StringHandle SclGetValueByName layer]
  
  if {$str_layer == $block_layer} {
    set block_found 1
    puts "Найден контур блока в слое $str_layer"
    
    # Итерируем по сегментам строки
    $StringHandle SclIterateLast StringIterator
    while {[$StringIterator SclIteratePrev SegmentHandle] == $SCL_TRUE} {
      
      # Получаем начальную точку сегмента
      $SegmentHandle SclGetItem PointHandle 0
      set x [$PointHandle SclGetValueByName x]
      set y [$PointHandle SclGetValueByName y]
      set z [$PointHandle SclGetValueByName z]
      
      # Накапливаем координаты для вычисления центра
      set sum_x [expr {$sum_x + $x}]
      set sum_y [expr {$sum_y + $y}]
      incr vertex_count
      
      # Сохраняем вершины
      lappend block_vertices [list $x $y $z]
    }
    
    break
  }
}

if {!$block_found} {
  puts "ОШИБКА: Контур блока не найден в слое $block_layer"
  exit
}

if {$vertex_count == 0} {
  puts "ОШИБКА: Не удалось прочитать вершины контура"
  exit
}

# Вычисляем центр блока
set center_x [expr {$sum_x / $vertex_count}]
set center_y [expr {$sum_y / $vertex_count}]
set center_z 0.0

puts "Центр блока: X=$center_x, Y=$center_y"
puts "Количество вершин: $vertex_count"

#------------------------------------------------------------------------------
# ШАГ 2: СОЗДАНИЕ ВЫХОДНОГО ФАЙЛА И БУФЕРОВ
#------------------------------------------------------------------------------

SclCreateSwa SwaHandleOutput "strings"
$SwaHandleOutput SclGetStrings OutputStringsHandle

# Счётчик для слоёв
set layer_counter 10

#------------------------------------------------------------------------------
# ШАГ 3: ПОСТРОЕНИЕ БУФЕРОВ
#------------------------------------------------------------------------------

foreach radius $radii_list {
  
  set radius [string trim $radius]
  
  if {![string is double $radius] || $radius <= 0} {
    puts "ПРЕДУПРЕЖДЕНИЕ: Пропущен некорректный радиус '$radius'"
    continue
  }
  
  puts "------------------------------------------"
  puts "Создание буфера радиусом $radius м"
  puts "------------------------------------------"
  
  # Определяем цвет и стиль линии
  if {$radius <= 250} {
    set line_color 5  ;# Розовый
    set line_style 2  ;# Пунктир
  } elseif {$radius <= 500} {
    set line_color 2  ;# Красный
    set line_style 2  ;# Пунктир
  } elseif {$radius <= 750} {
    set line_color 3  ;# Оранжевый
    set line_style 2  ;# Пунктир
  } else {
    set line_color 4  ;# Жёлтый
    set line_style 2  ;# Пунктир
  }
  
  #----------------------------------------------------------------------------
  # РЕЖИМ 0: КРУГИ ОТ ЦЕНТРА
  #----------------------------------------------------------------------------
  
  if {$buffer_mode == 0} {
    
    puts "Режим: круг от центра"
    
    # Создаём новую строку для окружности
    $OutputStringsHandle SclCreateItem CircleStringHandle
    $CircleStringHandle SclSetValueByName layer $layer_counter
    $CircleStringHandle SclSetValueByName colour $line_color
    $CircleStringHandle SclSetValueByName style $line_style
    $CircleStringHandle SclSetValueByName description "BUF_${radius}m"
    
    # Строим окружность из сегментов
    set num_segments 72
    set angle_step [expr {360.0 / $num_segments}]
    set pi 3.14159265359
    
    for {set i 0} {$i < $num_segments} {incr i} {
      set angle [expr {$i * $angle_step * $pi / 180.0}]
      set x [expr {$center_x + $radius * cos($angle)}]
      set y [expr {$center_y + $radius * sin($angle)}]
      set z $center_z
      
      # Создаём сегмент
      $CircleStringHandle SclCreateItem SegmentHandle
      
      # Создаём начальную точку сегмента
      $SegmentHandle SclCreateItem PointHandle
      $PointHandle SclSetValueByName x $x
      $PointHandle SclSetValueByName y $y
      $PointHandle SclSetValueByName z $z
    }
    
    # Замыкаем окружность - добавляем последний сегмент к первой точке
    set angle 0.0
    set x [expr {$center_x + $radius * cos($angle)}]
    set y [expr {$center_y + $radius * sin($angle)}]
    set z $center_z
    
    $CircleStringHandle SclCreateItem SegmentHandle
    $SegmentHandle SclCreateItem PointHandle
    $PointHandle SclSetValueByName x $x
    $PointHandle SclSetValueByName y $y
    $PointHandle SclSetValueByName z $z
    
    puts "Создана окружность радиусом $radius м в слое $layer_counter"
    
  #----------------------------------------------------------------------------
  # РЕЖИМ 1: ОФФСЕТ КОНТУРА
  #----------------------------------------------------------------------------
  
  } else {
    
    puts "Режим: оффсет контура"
    
    # Создаём новую строку для смещённого контура
    $OutputStringsHandle SclCreateItem OffsetStringHandle
    $OffsetStringHandle SclSetValueByName layer $layer_counter
    $OffsetStringHandle SclSetValueByName colour $line_color
    $OffsetStringHandle SclSetValueByName style $line_style
    $OffsetStringHandle SclSetValueByName description "BUF_${radius}m_offset"
    
    # Упрощённый алгоритм оффсета через смещение нормалей
    set num_vertices [llength $block_vertices]
    
    for {set i 0} {$i < $num_vertices} {incr i} {
      
      set v_prev [lindex $block_vertices [expr {($i - 1 + $num_vertices) % $num_vertices}]]
      set v_curr [lindex $block_vertices $i]
      set v_next [lindex $block_vertices [expr {($i + 1) % $num_vertices}]]
      
      # Векторы рёбер
      set dx1 [expr {[lindex $v_curr 0] - [lindex $v_prev 0]}]
      set dy1 [expr {[lindex $v_curr 1] - [lindex $v_prev 1]}]
      
      set dx2 [expr {[lindex $v_next 0] - [lindex $v_curr 0]}]
      set dy2 [expr {[lindex $v_next 1] - [lindex $v_curr 1]}]
      
      # Нормали (перпендикуляры) к рёбрам
      set nx1 [expr {-$dy1}]
      set ny1 $dx1
      set len1 [expr {sqrt($nx1*$nx1 + $ny1*$ny1)}]
      
      set nx2 [expr {-$dy2}]
      set ny2 $dx2
      set len2 [expr {sqrt($nx2*$nx2 + $ny2*$ny2)}]
      
      # Нормализация
      if {$len1 > 0} {
        set nx1 [expr {$nx1 / $len1}]
        set ny1 [expr {$ny1 / $len1}]
      }
      
      if {$len2 > 0} {
        set nx2 [expr {$nx2 / $len2}]
        set ny2 [expr {$ny2 / $len2}]
      }
      
      # Средняя нормаль
      set nx [expr {($nx1 + $nx2) / 2.0}]
      set ny [expr {($ny1 + $ny2) / 2.0}]
      set nlen [expr {sqrt($nx*$nx + $ny*$ny)}]
      
      if {$nlen > 0} {
        set nx [expr {$nx / $nlen}]
        set ny [expr {$ny / $nlen}]
      }
      
      # Смещаем вершину наружу
      set new_x [expr {[lindex $v_curr 0] + $nx * $radius}]
      set new_y [expr {[lindex $v_curr 1] + $ny * $radius}]
      set new_z [lindex $v_curr 2]
      
      # Создаём сегмент
      $OffsetStringHandle SclCreateItem SegmentHandle
      $SegmentHandle SclCreateItem PointHandle
      $PointHandle SclSetValueByName x $new_x
      $PointHandle SclSetValueByName y $new_y
      $PointHandle SclSetValueByName z $new_z
    }
    
    # Замыкаем контур
    set v_first [lindex $block_vertices 0]
    set v_second [lindex $block_vertices 1]
    
    set dx [expr {[lindex $v_second 0] - [lindex $v_first 0]}]
    set dy [expr {[lindex $v_second 1] - [lindex $v_first 1]}]
    set nx [expr {-$dy}]
    set ny $dx
    set nlen [expr {sqrt($nx*$nx + $ny*$ny)}]
    
    if {$nlen > 0} {
      set nx [expr {$nx / $nlen}]
      set ny [expr {$ny / $nlen}]
    }
    
    set new_x [expr {[lindex $v_first 0] + $nx * $radius}]
    set new_y [expr {[lindex $v_first 1] + $ny * $radius}]
    set new_z [lindex $v_first 2]
    
    $OffsetStringHandle SclCreateItem SegmentHandle
    $SegmentHandle SclCreateItem PointHandle
    $PointHandle SclSetValueByName x $new_x
    $PointHandle SclSetValueByName y $new_y
    $PointHandle SclSetValueByName z $new_z
    
    puts "Создан смещённый контур радиусом $radius м в слое $layer_counter"
  }
  
  #----------------------------------------------------------------------------
  # ДОБАВЛЕНИЕ ТЕКСТОВОЙ МЕТКИ (если включено)
  #----------------------------------------------------------------------------
  
  if {$add_labels} {
    # Текст в Surpac создаётся как отдельная строка специального типа
    # Это упрощённая реализация - может потребоваться адаптация
    puts "Добавление подписи: ${radius}м"
  }
  incr layer_counter
}
#------------------------------------------------------------------------------
# ШАГ 4: СОХРАНЕНИЕ ВЫХОДНОГО ФАЙЛА
#------------------------------------------------------------------------------

$SwaHandleOutput SclSwaSaveStringFile $out_buffer_file

puts "=========================================="
puts "ГОТОВО!"
puts "Буферные зоны сохранены в: $out_buffer_file"
puts "=========================================="
